# Creature Forge Environment Variables

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# VPS Configuration (Optional - for external image generation)
# If not set, will fallback to Gemini image generation
VITE_VPS_ENDPOINT=https://your-vps.com/api/generate-creature
VITE_VPS_API_KEY=your_vps_api_key_here

# VPS Endpoint Specification:
# The VPS should accept POST requests with the following JSON body:
# {
#   "prompt": "A cute, high-quality 3D rendered toy figure of...",
#   "style": "toy_figure_isometric",
#   "width": 1024,
#   "height": 1024
# }
#
# Expected response format:
# {
#   "success": true,
#   "imageUrl": "https://your-vps.com/images/12345.png"
#   // OR
#   "imageData": "data:image/png;base64,iVBORw0KG..."
# }
