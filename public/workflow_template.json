{
    "1": {
        "inputs": {
            "image": "{{INPUT_IMAGE}}",
            "upload": "image"
        },
        "class_type": "LoadImage",
        "_meta": {
            "title": "Load Image"
        }
    },
    "2": {
        "inputs": {
            "model": "model.ckpt",
            "chunk_size": 8192
        },
        "class_type": "TripoSRModelLoader",
        "_meta": {
            "title": "Load TripoSR Model"
        }
    },
    "3": {
        "inputs": {
            "reference_image": [
                "4",
                0
            ],
            "model": [
                "2",
                0
            ],
            "geometry_resolution": 256,
            "threshold": 25,
            "reference_mask": [
                "7",
                0
            ]
        },
        "class_type": "TripoSRSampler",
        "_meta": {
            "title": "TripoSR Generation"
        }
    },
    "4": {
        "inputs": {
            "upscale_method": "bicubic",
            "width": 512,
            "height": 512,
            "crop": "center",
            "image": [
                "1",
                0
            ]
        },
        "class_type": "ImageScale",
        "_meta": {
            "title": "Resize Image (Standard)"
        }
    },
    "5": {
        "inputs": {
            "mask": [
                "1",
                1
            ]
        },
        "class_type": "MaskToImage",
        "_meta": {
            "title": "Convert Mask to Image"
        }
    },
    "6": {
        "inputs": {
            "upscale_method": "bicubic",
            "width": 512,
            "height": 512,
            "crop": "center",
            "image": [
                "5",
                0
            ]
        },
        "class_type": "ImageScale",
        "_meta": {
            "title": "Resize Mask Image"
        }
    },
    "7": {
        "inputs": {
            "channel": "red",
            "image": [
                "6",
                0
            ]
        },
        "class_type": "ImageToMask",
        "_meta": {
            "title": "Convert Image to Mask"
        }
    },
    "8": {
        "inputs": {
            "mesh": [
                "3",
                0
            ]
        },
        "class_type": "TripoSRViewer",
        "_meta": {
            "title": "TripoSR Mesh Viewer"
        }
    }
}